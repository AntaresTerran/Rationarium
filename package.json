{
  "name": "rationarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config src/client/vite.config.ts --host 127.0.0.1",
    "build": "npm run build:client && node scripts/embed-assets.mjs && npm run build:server",
    "build:client": "vite build --config src/client/vite.config.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.cjs --packages=bundle",
    "start": "node dist/server.cjs",
    "demo": "node dist/server.cjs --demo",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "package:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-exe.ps1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
